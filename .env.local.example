# .env.local.example
# Copy this to .env.local and fill in your values
# .env.local is git-ignored and should contain secrets

# Local Development Environment
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=generate-a-unique-local-secret

# Local Database
MYSQL_ROOT_PASSWORD=set-a-unique-local-root-password
DATABASE_URL=mysql://root:set-a-unique-local-root-password@mysql:3306/homeadmin24?serverVersion=9.0&charset=utf8mb4&collation=utf8mb4_unicode_ci

# AI Configuration for Local Development
# Claude is opt-in for local testing.
AI_ENABLED=false
AI_CLAUDE_ENABLED=true
# Set this only in your untracked .env.local file.
ANTHROPIC_API_KEY=

# Ollama is deliberately not part of the default Compose stack. Run it separately
# only when explicitly needed for local development.
