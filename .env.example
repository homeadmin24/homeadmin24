# Environment Configuration Template
# Copy this file to .env and fill in your actual values
#
# NOTE: For DigitalOcean demo deployment, run deploy-demo.sh which auto-configures this!

# Application Environment
APP_ENV=dev
APP_SECRET=your-secret-key-here

# HGA PDF Renderer
HGA_PDF_RENDERER=chrome

# Database Configuration
# MySQL is only reachable inside the Docker network via the "mysql" service.
# Store the actual password in .env.local, never in this tracked template.
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
DATABASE_URL="mysql://root:replace-with-a-local-password@mysql:3306/homeadmin24?serverVersion=9.0&charset=utf8mb4"

# Demo System Configuration
# Password for all demo users (viewer@demo.local, wegadmin@demo.local, etc.)
DEMO_PASSWORD=demo123

# Mailer Configuration (if needed)
# MAILER_DSN=null://null

# Trusted Proxies (for reverse proxy deployments like Nginx)
# Uncomment and set to your proxy IP if using Nginx/Apache reverse proxy
# TRUSTED_PROXIES=127.0.0.1
# TRUSTED_HOSTS=^yourdomain\.com$

# AI Integration (local-only)
AI_ENABLED=false
AI_CLAUDE_ENABLED=false
DOCINTEL_ENABLED=false
DOCINTEL_URL=http://doc-intel:8000
