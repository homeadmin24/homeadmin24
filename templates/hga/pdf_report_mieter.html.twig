<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Betriebskostenabrechnung {{ data.year }} - {{ data.einheit.nummer }}</title>
    <style>
        @page {
            margin: 80px 25px 40px 25px;
        }

        .page-header {
            font-size: 8pt;
            text-align: center;
            border-bottom: 1px solid #333;
            padding-bottom: 8px;
            margin-bottom: 15px;
            color: #333;
        }

        .footer {
            position: fixed;
            bottom: -30px;
            left: 0px;
            right: 0px;
            height: 30px;
            font-size: 7pt;
            text-align: center;
            border-top: 1px solid #333;
            padding-top: 5px;
        }

        .footer:before {
            content: "Betriebskostenabrechnung {{ data.year }} - {{ data.einheit.nummer }} {{ data.einheit.beschreibung }} - Seite " counter(page);
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 9pt;
            line-height: 1.3;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .page-content {
            max-width: calc(100% - 50px);
            margin: 0 auto;
            padding: 0 25px;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
        }

        .header h1 {
            font-size: 16pt;
            font-weight: bold;
            margin: 0 0 5px 0;
            text-transform: uppercase;
        }

        .meta-info {
            font-size: 8pt;
            color: #333;
            margin-top: 8px;
        }

        .section {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .section.allow-break {
            page-break-inside: auto;
        }

        .section-title {
            font-size: 10pt;
            font-weight: bold;
            background-color: #f8f8f8;
            padding: 5px 8px;
            border-bottom: 1px solid #333;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .info-grid {
            display: table;
            width: 100%;
            margin-bottom: 15px;
        }

        .info-row {
            display: table-row;
        }

        .info-label {
            display: table-cell;
            font-weight: bold;
            width: 30%;
            padding: 2px 10px 2px 0;
        }

        .info-value {
            display: table-cell;
            padding: 2px 0;
        }

        .result-box {
            background-color: #f5f5f5;
            border: 1px solid #333;
            padding: 6px 8px;
            text-align: center;
            margin: 10px 0;
            border-radius: 0;
        }

        .result-box .result-text {
            font-size: 9pt;
            font-weight: bold;
            color: #333;
        }

        .cost-table {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0;
            font-size: 8pt;
        }

        .cost-table th {
            background-color: #f8f8f8;
            padding: 5px;
            text-align: left;
            border-bottom: 1px solid #333;
            font-weight: bold;
        }

        .cost-table td {
            padding: 3px 5px;
            border-bottom: 1px solid #eee;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .cost-table td.amount {
            text-align: right;
            font-family: 'Courier New', monospace;
        }

        .cost-table .subtotal {
            font-weight: bold;
            background-color: #f5f5f5;
            border-top: 1px solid #999;
        }

        .cost-table .total {
            font-weight: bold;
            background-color: #e8e8e8;
            border-top: 2px solid #333;
            font-size: 9pt;
        }

        .tax-section {
            background-color: #f8f8f8;
            border: 1px solid #333;
            padding: 8px;
            margin: 10px 0;
        }

        .tax-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7pt;
            margin: 5px 0;
        }

        .tax-table th {
            background-color: #f8f8f8;
            padding: 5px;
            text-align: center;
            border-bottom: 1px solid #333;
            font-weight: bold;
        }

        .tax-table td {
            padding: 3px 5px;
            border-bottom: 1px solid #eee;
            text-align: right;
        }

        .tax-table td.label {
            text-align: left;
        }

        .amount {
            font-family: 'Courier New', monospace;
        }

        .page-break {
            page-break-before: always;
        }

        .info-box {
            background-color: #f0f7ff;
            border: 1px solid #0066cc;
            border-left: 4px solid #0066cc;
            padding: 10px 12px;
            margin: 15px 0;
            font-size: 8pt;
        }

        .info-box strong {
            color: #0066cc;
        }

        h3 {
            margin-top: 5px;
            margin-bottom: 8px;
        }

        .preview {
            background: #f2f2f2;
        }

        .preview .page-content {
            width: 210mm;
            max-width: none;
            margin: 20px auto;
            padding: 0 20mm 40px;
            background: #fff;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .preview .page-header {
            position: sticky;
            top: 0;
            z-index: 5;
            background: #fff;
        }

        .preview .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 24px;
            margin: 0;
            padding-top: 4px;
            background: #fff;
            border-top: 1px solid #ddd;
        }

        .preview .section.page-break {
            border-top: 2px dashed #c0c0c0;
            margin-top: 60px;
            padding-top: 20px;
            position: relative;
        }

        .preview .section.page-break::after {
            content: "Seitenumbruch";
            position: absolute;
            top: -12px;
            right: 0;
            background: #fff;
            padding: 0 6px;
            font-size: 7pt;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
    </style>
</head>
<body class="{{ previewMode|default(false) ? 'preview' : '' }}">
    {% if previewMode|default(false) %}
    <div class="footer"></div>
    {% endif %}

    <div class="page-content">
    {# ==================== PAGE 1: UMLAGEERGEBNIS MIETER ==================== #}
    <div class="header">
        <h1>Betriebskostenabrechnung {{ data.year }}</h1>
        <div class="meta-info">
            Erstellung: {{ generatedAt|date('d.m.Y') }}<br>
            Objekt: {{ data.weg.name }}, {{ data.weg.adresse }}<br>
            Abrechnungszeitraum: {{ data.calculationMethod.periodLabel }}
        </div>
    </div>

    <div class="section allow-break">
        <div class="section-title">Mieter Information</div>
        <div class="info-grid">
            <div class="info-row">
                <div class="info-label">Wohnung:</div>
                <div class="info-value">{{ data.einheit.nummer }} {{ data.einheit.beschreibung }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Eigentümer:</div>
                <div class="info-value">{{ data.einheit.eigentuemer }}</div>
            </div>
            {% if data.einheit.address %}
            <div class="info-row">
                <div class="info-label">Adresse:</div>
                <div class="info-value">{{ data.einheit.address }}</div>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="info-box">
        <strong>Abrechnungsprinzip:</strong> {{ data.calculationMethod.name }}<br>
        <small>Rechtsgrundlage: {{ data.calculationMethod.legalBasis }}</small>
    </div>

    <div class="section allow-break">
        <div class="section-title">Umlageergebnis {{ data.calculationMethod.name }}</div>

        <div style="margin-bottom: 20px;">
            <h3>Umlagefähige Betriebskosten</h3>
            <table class="cost-table">
                <thead>
                    <tr>
                        <th>Kostenart</th>
                        <th style="text-align: center;">Umlageschlüssel</th>
                        <th style="text-align: right;">Gesamtkosten</th>
                        <th style="text-align: right;">Ihr Anteil</th>
                    </tr>
                </thead>
                <tbody>
                    {% if data.external_costs %}
                    <tr class="subtotal">
                        <td colspan="4"><strong>HEIZUNG/WASSER/ABRECHNUNG:</strong></td>
                    </tr>
                    <tr>
                        <td>ext. berechn. Heizkosten</td>
                        <td style="text-align: center;">01*</td>
                        <td class="amount">{{ data.external_costs.heating.total|default(0)|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ data.external_costs.heating.unit_share|default(0)|number_format(2, ',', '.') }} €</td>
                    </tr>
                    <tr>
                        <td>ext. berechn. Wasser-/sonst. Kosten</td>
                        <td style="text-align: center;">01*</td>
                        <td class="amount">{{ data.external_costs.water.total|default(0)|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ data.external_costs.water.unit_share|default(0)|number_format(2, ',', '.') }} €</td>
                    </tr>
                    <tr class="subtotal">
                        <td colspan="2">Zwischensumme: Heizung/Wasser/Abrechnung</td>
                        <td class="amount">{{ ((data.external_costs.heating.total|default(0)) + (data.external_costs.water.total|default(0)))|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ ((data.external_costs.heating.unit_share|default(0)) + (data.external_costs.water.unit_share|default(0)))|number_format(2, ',', '.') }} €</td>
                    </tr>
                    <tr class="subtotal">
                        <td colspan="4"><strong>SONSTIGE UMLAGEFÄHIGE KOSTEN:</strong></td>
                    </tr>
                    {% endif %}

                    {% for item in data.costs.umlagefaehig.items|default([]) %}
                    {% if item.total|default(0) > 0 %}
                    <tr>
                        <td>{{ item.kostenkonto }} - {{ item.beschreibung }}</td>
                        <td style="text-align: center;">{{ item.verteilungsschluessel|default('05*') }}</td>
                        <td class="amount">{{ item.total|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ item.anteil|number_format(2, ',', '.') }} €</td>
                    </tr>
                    {% endif %}
                    {% endfor %}

                    {% set sonstigeTotal = 0 %}
                    {% set sonstigeAnteil = 0 %}
                    {% for item in data.costs.umlagefaehig.items|default([]) %}
                        {% if item.total|default(0) > 0 %}
                        {% set sonstigeTotal = sonstigeTotal + item.total %}
                        {% set sonstigeAnteil = sonstigeAnteil + item.anteil %}
                        {% endif %}
                    {% endfor %}

                    <tr class="subtotal">
                        <td colspan="2">Zwischensumme: Sonstige</td>
                        <td class="amount">{{ sonstigeTotal|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ sonstigeAnteil|number_format(2, ',', '.') }} €</td>
                    </tr>

                    {% set totalUmlagefaehigWeg = ((data.external_costs.heating.total|default(0)) + (data.external_costs.water.total|default(0))) + sonstigeTotal %}
                    {% set totalUmlagefaehigUnit = ((data.external_costs.heating.unit_share|default(0)) + (data.external_costs.water.unit_share|default(0))) + sonstigeAnteil %}

                    <tr class="total">
                        <td colspan="2">SUMME: Umlagefähige Betriebskosten</td>
                        <td class="amount">{{ totalUmlagefaehigWeg|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ totalUmlagefaehigUnit|number_format(2, ',', '.') }} €</td>
                    </tr>
                </tbody>
            </table>
        </div>

        {# Abrechnungsergebnis #}
        <div style="margin-top: 20px; border-top: 3px solid #333; padding-top: 10px;">
            <table class="cost-table">
                <tbody>
                    <tr>
                        <td style="width: 60%;"><strong>Ihre Betriebskosten:</strong></td>
                        <td class="amount"><strong>{{ totalUmlagefaehigUnit|number_format(2, ',', '.') }} €</strong></td>
                    </tr>
                </tbody>
            </table>

            <div class="result-box" style="margin-top: 15px;">
                <div class="result-text">
                    Ihre umlagefähigen Betriebskosten {{ data.year }}: {{ totalUmlagefaehigUnit|number_format(2, ',', '.') }} €
                </div>
            </div>
        </div>
    </div>

    {# ==================== PAGE 2: §35a EStG ==================== #}
    {% if data.tax_deductible.items|default([]) %}
    <div class="section page-break">
        <div class="page-header">
            Betriebskostenabrechnung {{ data.year }} - {{ data.einheit.nummer }} {{ data.einheit.beschreibung }}
        </div>
        <div class="section-title">Abrechnung für Ausgaben i.S.d. §35a Einkommensteuergesetz</div>
        <div class="info-grid">
            <div class="info-row">
                <div class="info-label">Wohnung:</div>
                <div class="info-value">{{ data.einheit.nummer }} {{ data.einheit.beschreibung }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Eigentümer:</div>
                <div class="info-value">{{ data.einheit.eigentuemer }}</div>
            </div>
            {% if data.einheit.address %}
            <div class="info-row">
                <div class="info-label">Adresse:</div>
                <div class="info-value">{{ data.einheit.address }}</div>
            </div>
            {% endif %}
        </div>
        <div class="tax-section">
            <div class="section-title">Steuerbegünstigte Leistungen nach §35a EStG</div>
            <table class="tax-table">
                <thead>
                    <tr>
                        <th>Handwerkerleistungen</th>
                        <th>Gesamtkosten</th>
                        <th>anrechenbar</th>
                        <th>Ihr Anteil (Kosten)</th>
                        <th>Ihr Anteil (anrechenbar)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in data.tax_deductible.items %}
                    <tr>
                        <td class="label">{{ item.kostenkonto }} - {{ item.beschreibung }} {{ item.verteilungsschluessel }}</td>
                        <td class="amount">{{ item.gesamtkosten|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ item.anrechenbar|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ item.anteil_kosten|number_format(2, ',', '.') }} €</td>
                        <td class="amount">{{ item.anteil_anrechenbar|number_format(2, ',', '.') }} €</td>
                    </tr>
                    {% endfor %}
                    <tr class="total">
                        <td class="label"><strong>SUMME Handwerkerleistungen</strong></td>
                        {% set totalGesamtkosten = data.tax_deductible.items|reduce((sum, item) => sum + item.gesamtkosten, 0) %}
                        {% set totalAnrechenbar = data.tax_deductible.items|reduce((sum, item) => sum + item.anrechenbar, 0) %}
                        {% set totalAnteilKosten = data.tax_deductible.items|reduce((sum, item) => sum + item.anteil_kosten, 0) %}
                        <td class="amount"><strong>{{ totalGesamtkosten|number_format(2, ',', '.') }} €</strong></td>
                        <td class="amount"><strong>{{ totalAnrechenbar|number_format(2, ',', '.') }} €</strong></td>
                        <td class="amount"><strong>{{ totalAnteilKosten|number_format(2, ',', '.') }} €</strong></td>
                        <td class="amount"><strong>{{ data.tax_deductible.total_anrechenbar|number_format(2, ',', '.') }} €</strong></td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-top: 10px; padding: 8px; background-color: #f5f5f5; border-left: 4px solid #333;">
                <strong>Ihr steuerlich absetzbarer Betrag (100% der Arbeits-/Fahrtkosten inkl. MwSt.): {{ data.tax_deductible.total_anrechenbar|number_format(2, ',', '.') }} EUR</strong>
            </div>

            <div style="margin-top: 8px; font-size: 8pt; color: #333;">
                <strong>HINWEIS:</strong> Diese Beträge können Sie in Ihrer Steuererklärung als haushaltsnahe
                Dienstleistungen geltend machen (20% davon, max. 1.200 EUR Steuerermäßigung pro Jahr).
            </div>
        </div>
    </div>
    {% endif %}

    </div> <!-- Close page-content -->
</body>
</html>
